// SteamPipe depot: Windows x64 (froxel.exe, README.md, LICENSE).
// @STEAM_DEPOT_WINDOWS_X64@ is a placeholder that packaging/steam/build.sh fills in
// from the repository variable STEAM_DEPOT_WINDOWS_X64 (see app_build.vdf).
// The files are the release build unpacked into content/windows-x64/.
"DepotBuild"
{
	"DepotID" "@STEAM_DEPOT_WINDOWS_X64@"
	"ContentRoot" "@CONTENT_ROOT@/windows-x64"
	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"Recursive" "1"
	}
	"FileExclusion" "*.pdb"
}
